apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/local.properties
apps/mobile/android/capacitor-cordova-android-plugins/build/
*.apk
*.aab
*.keystore
*.jks

# ─── Release archives ─────────────────────────────────────────────────────────
releases/

# ─── Editors / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.log

# ─── Vite ─────────────────────────────────────────────────────────────────────
.vite/
.vite-temp/

